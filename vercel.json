{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/",
            "destination": "/frontend/pages/login.html"
        },
        {
            "source": "/login",
            "destination": "/frontend/pages/login.html"
        },
        {
            "source": "/admin",
            "destination": "/frontend/pages/admin.html"
        },
        {
            "source": "/faculty",
            "destination": "/frontend/pages/faculty.html"
        },
        {
            "source": "/student",
            "destination": "/frontend/pages/student.html"
        },
        {
            "source": "/pages/(.*)",
            "destination": "/frontend/pages/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/frontend/$1"
        }
    ]
}